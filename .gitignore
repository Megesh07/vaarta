# Build outputs
build/
out/
bin/
.gradle/
.kotlin/
*.apk
*.aab

# Local machine config (SDK path is per-developer)
local.properties

# Signing / secrets — NEVER commit these (guardrail: no secrets in the repo)
*.jks
*.keystore
keystore.properties
secrets.properties
.env
.env.*
!.env.example

# IDE
.idea/
*.iml
.vscode/

# OS
.DS_Store
Thumbs.db

# Android native / profiling
captures/
.cxx/
*.hprof
.navigation/

# Model packs (fetched on demand per docs/CONTRIBUTING.md §2, not checked into git)
/models/

# tools:eval benchmark artifacts — raw model responses and generated reports must never be
# committed; re-running the harness must never depend on committed state.
tools/eval/.cache/
tools/eval/out/

# Keep the verified team handoff docs; ignore private working notes and historical drafts by default.
/docs/*
!/docs/
!/docs/TEAM_GUIDE.md
!/docs/ARCHITECTURE_CURRENT.md
!/docs/BASELINE_CHECKLIST.md
/PROJECT_STATUS.md
/CODE_OF_CONDUCT.md
!/SECURITY.md
/.superpowers/
/.claude/

# Local Codex/agent working files and generated review artifacts
/.codex-*/
/.codex-*.log
/output/
/tmp/
/VAARTA-Submission-Document.pdf
